<?xml version="1.0" encoding="utf-8"?>
<!-- Andalusian lapis glass card matching the app's Islamic Blue theme -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:startColor="#0A1633"
        android:centerColor="#142A5C"
        android:endColor="#0A1633"
        android:angle="135"
        android:type="linear" />

    <corners android:radius="24dp" />

    <!-- Gold lit edge -->
    <stroke
        android:width="1dp"
        android:color="#59E8BC63" />

</shape>
