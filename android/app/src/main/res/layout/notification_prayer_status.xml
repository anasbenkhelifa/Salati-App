<?xml version="1.0" encoding="utf-8"?>
<!--
    Content area of the persistent prayer countdown notification.

    A custom RemoteViews layout is used instead of plain setContentText because
    SystemUI (One UI in particular) strips StyleSpan/ForegroundColorSpan out of
    the standard notification template — bold and the red warning colour only
    survive when they come from the layout itself.

    Wrapped in DecoratedCustomViewStyle, so the system still draws the small
    icon, app name and expand affordance around this.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notif_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_prayer"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/notif_time"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_separator"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:text="|" />

        <TextView
            android:id="@+id/notif_countdown"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
